    LAUNCH["🚀 Launch: SA-first · PayFast R50/mo · sameness + accurate costing"]

    START --> PUSH --> NEXT --> EVENTS --> LATER --> LAUNCH
    NEXT -.-> DONE
    NEXT -.-> CONTENT
    LATER -.-> PRICELEFT
    PARKED -.-> LAUNCH

    classDef push fill:#b5462b,stroke:#2c211a,color:#fff
    classDef next fill:#d98a2b,stroke:#2c211a,color:#2c211a
    classDef done fill:#46530c,stroke:#2c211a,color:#fff
    classDef content fill:#fbf3e6,stroke:#876213,color:#2c211a
    classDef now fill:#fff3e0,stroke:#b5462b,color:#2c211a
    classDef price fill:#876213,stroke:#2c211a,color:#fff
    classDef feat fill:#fffaf2,stroke:#b5462b,color:#2c211a

    class PU1 push
    class K0,K1,K2,K3,K4,K5 next
    class D6,DW3,DP,DAL,DPR done
    class C1,C2 content
    class E3,E4,E5,A1,A2 now
    class PL1,PL2,PSTAB price
    class F1,F3,FSCOUT,MK feat
