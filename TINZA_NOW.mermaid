flowchart TD
    START["🌙 TINZA — carry into NEW chat. Costing now 91% real prices."]

    subgraph PUSH["⬆️ ONE small re-push pending"]
        PU1["prices.js — tinned asparagus R197 added (fresh stays R513). Last price change. Everything else already pushed ✓"]
    end

    subgraph NEXT["🎯 NEXT TASK — E2 Kiddies My Plan → buildPlanData (DECISION LOCKED)"]
        K0["WHY buildPlanData not a 4th noCost adapter: real per-kid costing (cake+cooldrink now priced), auto dedup (normIngredientKey), auto aisle + pack-rounding, no debt to unwind. Buffet already proved the pattern."]
        K1["SCOPE (read live first): kidsPlanItems() builds items each with base12 (ingredients for 12 kids). kidsPlanHTML() L738 renders bespoke cost (costPP×k) + shop."]
        K2["ADAPTER: for each non-removed item, scale base12 ingredients by k/12 → {name, amt, unit, priceName}. Collect dishes[] → planView({dishes,...}) (copy Buffet buffet.js STEP 2 ~L687-752)."]
        K3["REPLACES bespoke kidsPlanHTML cost+shop block with shared planView → buildPlanData → shoppingView. Keep per-kid (k) selector + theme/budget UI."]
        K4["GOTCHAS: base12 scaling (×k/12 BEFORE feeding — buildPlanData never re-portions); cake/drink/popcorn/dips items; extra snacks carry costPP directly; confirm base12 ingredient field names {n,amt,unit?} in live code."]
        K5["DoD (CLAUDE.md §10): plan opens · k +/- rescales · shopping sums shared ingredients · scroll restores · node --check · live phone test."]
    end

    subgraph DONE["✅ DONE this session"]
        D6["E1 Finger Foods → shared shoppingView (pushed)"]
        DW3["CLAUDE.md at repo root"]
        DP["price-audit.js tool (node Tools/price-audit.js)"]
        DAL["50 aliases total (oil→sunflower, lamb→lamb neck, broths→stock, brewed espresso→coffee, greens→lettuce, pasta shapes, etc.)"]
        DPR["46 real prices locked (Tina). 85%→91%. Watermelon≠melon fixed. Toum renamed."]
    end

    subgraph CONTENT["📝 PARKED — batched recipe session"]
        C1["New recipes + cross-links: gnocchi, fresh pasta, pizza base, ciabatta, falafel, slap chips"]
        C2["ranch dressing → Spice ▸ Salad Dressings · parsnip substitute note · pine-nut→macadamia trivia"]
    end

    subgraph EVENTS["⏳ AFTER KIDDIES — finish Events"]
        E3["DELETE Cultural block (dead → World Kitchen)"]
        E4["EB2: selected sauces never reach buffet plan"]
        E5["Dead-code cull: buffetStep7 + S10 (dead fingerSummary/fingerShopListHTML)"]
    end

    subgraph LATER["➡️ THEN"]
        A1["Spice migration"]
        A2["Roll buildPlanData to ALL remaining plans + universal opener + page-compare"]
    end

    subgraph PRICELEFT["💰 PRICE — open (non-blocking)"]
        PL1["31 missing = mostly booze (skip) + niche; 80 alias gaps (diminishing returns)"]
        PL2["PACK_DB ~95% gaps → lists show cooking amounts not packets. Checkers-gated, deferred"]
        PSTAB["Run price-audit.js before+after data sessions to catch drift"]
