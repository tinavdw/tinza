flowchart TD
    START["🌙 TINZA — carry into NEW chat. Costing 91% real. Kiddies plan on shared engine + Kiddies menu STANDARD now locked."]

    subgraph PUSH["⬆️ NEXT PUSH (batched — Netlify credits)"]
        PU1["prices.js — tinned asparagus R197 (fresh stays R513)"]
        PU2["kiddies.js — E2 My Plan on shared planView→buildPlanData→shoppingView. node --check ✓, harness-proven (2.0× scaling, snacks expand, dips lossiness inherited). Push BOTH together."]
    end

    subgraph NEXT["🎯 NEXT TASK — finish Events sameness"]
        E3["DELETE Cultural block (dead → World Kitchen)"]
        E4["EB2: selected sauces never reach buffet plan"]
        E5["Dead-code cull: buffetStep7 + S10 (dead fingerSummary/fingerShopListHTML)"]
    end

    subgraph STD["📐 LOCKED — KIDDIES PARTY MENU STANDARD (TINZA_KIDDIES_STANDARD.md)"]
        ST1["CORE = 8 dishes/theme: 3 meaty · 2 savoury · 2 sweet · 1 healthy. Meaty = meaty:true flag on savoury type (no new browse cat)."]
        ST2["ADD-ON SPINE: 1 cake · 1 popcorn (add-on ONLY) · 2 dips (was 3) · 1 crisps (120g per 4 kids) · cooldrink"]
        ST3["PORTION = set amount per child, NO tiers (kids≠finger-foods, menu is curated not pick-your-own). Meaty 2 · savoury 2 · sweet 2 (1 if full-serving) · healthy 1 · cake 1 slice · popcorn 1 cup · crisps 30g · drink 400ml."]
        ST4["COOLDRINK 400ml/child — homemade scaled to 4800ml/12 AND store-bought 2x200ml. Fixes current 208-417ml drift."]
        ST5["PARKED knob: 'little/big kids' age-appetite toggle (x0.7) — NOT occasion tiers. Post-launch."]
    end

    subgraph KIDCONTENT["📝 NEXT-ish — Kiddies Standard rollout (fill plan READY, data-only)"]
        KC1["FILL PLAN DECIDED → TINZA_KIDDIES_FILL_PLAN.md. 12 themes balanced to 3 meaty/2 sav/2 sweet/1 healthy; ~20 ➕ adds all from existing photographed library (chicken strips, viennas, meatballs, kebabs, sosaties, rump bites, margherita, cheese puffs/pinwheels, cupcakes, fruit skewers). Cake+drink already palette-matched. Over-count dishes → addable pool (not deleted)."]
        KC2["Re-tag savoury→meaty/savoury · remove doubled popcorn (Unicorn, Space) + refill sweet · drop 1 dip x12 · rescale 12 drinks to 4800ml/12 · set per-child counts + rebuild base12"]
    end

    subgraph CONTENT["📝 PARKED — other recipe/data"]
        C1["New recipes: gnocchi, fresh pasta, pizza base, ciabatta, falafel, slap chips"]
        C2["ranch → Spice ▸ Salad Dressings · parsnip sub · pine-nut→macadamia trivia"]
        C3["Tidy ~11 dip strings (kidsDipsRecipe ADD map) free-text → structured so dips cost fully. Non-blocking."]
    end

    subgraph DONE["✅ DONE — E2 Kiddies My Plan → buildPlanData"]
        D1["kidsPlanDishes() adapter + kidsParseIng() parser; X_ snacks expanded (real base300, costed); crisps preserved; +/- → S.kidsCount; kidsToggleShop+S.kidsCheckedShop"]
        D2["Culled: kidsConsolidate/kidsFmtAmt/kidsPrice/kidsAisle/kidsNorm. Kept: kidsKeyLabel, kidsPlanItems."]
        D0["EARLIER: E1 Finger Foods shoppingView · CLAUDE.md root · price-audit.js · 50 aliases · 46 real prices (85→91%)"]
    end

    subgraph LATER["➡️ THEN"]
        A1["Spice migration"]
        A2["Roll buildPlanData to ALL remaining plans + universal opener + page-compare"]
