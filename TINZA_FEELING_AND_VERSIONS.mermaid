  subgraph PRIN["② VERSION STANDARD — the principle"]
    P0["NEED-DRIVEN, not count-driven. Every recipe = 1 WOW default + only the alternative chips that genuinely earn their place. Nigerian/Ukrainian dishes do NOT get 4 versions just because FMF does."]
    P1["UI = existing versions[] array → versionStrip chips. Default WOW = base (no chip); alternatives = chips. 'How many versions' = 'how many chips'."]
    P0-->P1
  end
  FEEL-->PRIN

  subgraph MENU["③ THE VERSION MENU (palette to pick from)"]
    M1["WOW — default, ALWAYS. Authentic + elevated (L1)."]
    M2["BUDGET — real cheaper execution (brown sugar not honey · stock not coconut milk)."]
    M3["QUICK — honest time-saver, real cooking, NEVER a box."]
    M4["VEGETARIAN / VEGAN — when it goes meat-free believably."]
    M5["SIMPLE / CLASSIC — pared-back + EXTRA-EXPLAINED, leans on SA substitutes (L18), fewer specialist steps. The 'African normal', but for ANY unfamiliar/fiddly dish."]
    M1-->M2-->M3-->M4-->M5
  end
  PRIN-->MENU

  subgraph MATRIX["④ HOW MANY, BY SECTION"]
    X1["FMF SUPPER (weeknight family staples) → FULL SET: WOW + Budget + Quick + Veg."]
    X2["SA & BRAAI heroes → WOW + whichever of Budget/Quick/Veg genuinely apply."]
    X3["WK FAMILIAR (European classics people know) → WOW + one (Quick OR Budget)."]
    X4["WK UNFAMILIAR / EXOTIC (Nigerian · Ukrainian · Ethiopian) → WOW + SIMPLE (2) baseline. Add Budget/Quick/Veg ONLY if they truly fit. ⭐ flagship rule."]
    X5["FLOOR / STRETCHER → 1 (it already IS the budget version)."]
    X6["BAKES & CAKES → WOW + flavour variations as chips (Bobotie rule)."]
    X1-->X2-->X3-->X4-->X5-->X6
  end
  MENU-->MATRIX

  subgraph LIT["⑤ THE LITMUS (before adding ANY version)"]
    L1a["Add a version ONLY if it (a) changes the dish in a way a real user would pick AND (b) makes honest culinary sense. Never pad."]
    L2a["If Veg would kill the dish identity (a dish ABOUT the beef) → make a DISTINCT CARD, not a chip (Bobotie rule)."]
    L3a["If 'Quick' would mean opening a box → don't add it."]
    L1a-->L2a-->L3a
  end
  MATRIX-->LIT

